PORT=3000
DATA_DIR=./data
# Customer sites are served at <name>.SITES_DOMAIN. Leave empty to serve them at /s/<name>/ instead.
SITES_DOMAIN=
# Public address of the builder itself, e.g. https://pfsites.com
APP_URL=
# Staff accounts that can open /app/admin
ADMIN_EMAILS=
# Hostname customers point their own domains at. Defaults to the builder's hostname.
CNAME_TARGET=
# Optional: attach verified customer domains to the Render service so certificates are issued automatically.
RENDER_API_KEY=
RENDER_SERVICE_ID=
