PORT=3000
DATA_DIR=./data
# Customer sites are served at <name>.SITES_DOMAIN. Leave empty to serve them at /s/<name>/ instead.
SITES_DOMAIN=
# Public address of the builder itself, e.g. https://pfsites.com
APP_URL=
# Staff accounts that can open /app/admin
ADMIN_EMAILS=
# Hostname customers point their own domains at. Defaults to the builder's hostname.
CNAME_TARGET=
# Optional: attach verified customer domains to the Render service so certificates are issued automatically.
RENDER_API_KEY=
RENDER_SERVICE_ID=
# Order emails (confirmations to customers, new-order alerts to the business) are sent through Resend.
# Without these, ordering still works and emails are skipped.
RESEND_API_KEY=
EMAIL_FROM=Orders <orders@yourdomain.com>

# Optional: lets merchants build their menu from a photo or PDF of a paper menu (Claude API key).
# Without it the "Scan a paper menu" button is simply not shown.
ANTHROPIC_API_KEY=

# Optional: sign-in codes by text message (two-step sign-in), sent through Twilio. Needs APP_URL too.
# Without these, text-message codes are not offered and the authenticator app still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sending number (+15551234567) or a Messaging Service SID; the service is used when both are set.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Country calling codes texts may go to (comma separated). Default: 1 (US and Canada).
SMS_COUNTRIES=1
# Most texts the server sends in an hour across everyone. Default: 600.
SMS_PER_HOUR=600

# Optional: new-order notifications on the PF Sites iPhone app (Apple Push Notification service).
# Without a key, the app works and iPhone notifications are simply off.
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.processorfreedomsites.app
# Production key (TestFlight and App Store builds): the key ID and the .p8 file's contents.
APNS_KEY_ID=
APNS_KEY=
# Optional development key (builds installed from Xcode). Falls back to the production key when missing.
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_KEY=
